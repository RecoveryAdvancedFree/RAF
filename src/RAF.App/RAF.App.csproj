<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- חבילת WebView2 כוללת גם וריאנט WPF שאיננו בשימוש; הסתרת התנגשות ההפניה שלו -->
    <MSBuildWarningsAsMessages>MSB3277</MSBuildWarningsAsMessages>
    <UseWindowsForms>true</UseWindowsForms>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <RootNamespace>RAF.App</RootNamespace>
    <AssemblyName>RAF</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>

    <!-- ניידות: קובץ EXE יחיד, ללא התקנה, ללא תלות ב-runtime -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- פלט נקי: קובץ EXE אחד בלבד, ללא קובצי תיעוד או ניפוי נלווים -->
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <AllowedReferenceRelatedFileExtensions>none</AllowedReferenceRelatedFileExtensions>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>

    <!--
      גיזום: חלקי ‎.NET שהתוכנה לא משתמשת בהם לא נכנסים לקובץ — 47MB ← כ-25MB.
      "חלקי" — נגזמות רק ספריות שסומנו כבטוחות לגיזום; הקוד של התוכנה, WinForms
      ו-WebView2 נשארים שלמים. WinForms מסמן גיזום כלא נתמך בגלל שימוש בהשתקפות
      בתוך עצמו — ולכן הוא עצמו אינו נגזם.
      BuiltInComInteropSupport: WebView2 ושורת המשימות מדברים עם Windows דרך COM,
      שגיזום מכבה כברירת מחדל. JsonSerializerIsReflectionEnabledByDefault: הגשר
      ממיר לממשק טיפוסים אנונימיים — בלעדיו הגיזום מכבה את ההמרה הזו.
    -->
    <PublishTrimmed Condition="'$(Configuration)' == 'Release'">true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <_SuppressWinFormsTrimError>true</_SuppressWinFormsTrimError>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>

    <!-- בניית בדיקה של גרסת ההפצה, עם שליטה מרחוק לבדיקות ממשק: dotnet publish -p:RafUiTest=true -->
    <DefineConstants Condition="'$(RafUiTest)' == 'true'">$(DefineConstants);REMOTE_UI_TEST</DefineConstants>

    <Product>שחזור מתקדם חינם</Product>
    <AssemblyTitle>RAF — Recovery Advanced Free</AssemblyTitle>
    <Company>RAF</Company>
    <Version>0.3.1</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RAF.Core\RAF.Core.csproj" />
  </ItemGroup>

  <!--
    הפצה עצמאית מעתיקה את חבילת Windows Desktop כולה, כולל WPF (כ-47MB),
    אף שהתוכנה משתמשת רק ב-WinForms. אף הרכבה שבשימוש אינה מפנה אליהן
    (נבדק על שרשרת ההפניות המלאה), ולכן הן מוסרות לפני יצירת deps.json,
    כך שהקבצים ורשימת התלויות נשארים עקביים.
  -->
  <Target Name="RemoveUnusedWpf" AfterTargets="ResolveRuntimePackAssets"
          Condition="'$(Configuration)' == 'Release'">
    <ItemGroup>
      <!-- הסיומת נחוצה כדי ש-Filename יכלול את השם המלא, כמו PresentationFramework.Aero -->
      <_UnusedWpf Include="
        PresentationCore.dll; PresentationFramework.dll; PresentationFramework-SystemCore.dll;
        PresentationFramework-SystemData.dll; PresentationFramework-SystemDrawing.dll;
        PresentationFramework-SystemXml.dll; PresentationFramework-SystemXmlLinq.dll;
        PresentationFramework.Aero.dll; PresentationFramework.Aero2.dll; PresentationFramework.AeroLite.dll;
        PresentationFramework.Classic.dll; PresentationFramework.Luna.dll; PresentationFramework.Royale.dll;
        PresentationUI.dll; ReachFramework.dll; System.Windows.Controls.Ribbon.dll;
        System.Windows.Input.Manipulations.dll; System.Windows.Presentation.dll; System.Xaml.dll;
        UIAutomationClient.dll; UIAutomationClientSideProviders.dll; UIAutomationProvider.dll;
        UIAutomationTypes.dll; WindowsBase.dll;
        D3DCompiler_47_cor3.dll; PenImc_cor3.dll; PresentationNative_cor3.dll; wpfgfx_cor3.dll" />
      <RuntimePackAsset Remove="@(_UnusedWpf)" MatchOnMetadata="Filename" />
      <ReferenceCopyLocalPaths Remove="@(_UnusedWpf)" MatchOnMetadata="Filename" />
    </ItemGroup>
  </Target>

  <!-- נכסי הממשק נצרבים לתוך ה-EXE ומוגשים מהזיכרון (ללא חילוץ לדיסק) -->
  <ItemGroup>
    <EmbeddedResource Include="Web\**\*" LogicalName="RAF.Web.%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
